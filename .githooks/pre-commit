#!/usr/bin/env bash
set -u

fail=0
em_dash="$(printf '\xe2\x80\x94')"
comment_start='(^[[:space:]]*(//|/\*|\*)|[[:space:]]//)'

problem() {
  echo "  $1: $2" >&2
  fail=1
}

added_lines() {
  git diff --cached -U0 --diff-filter=ACM -- "$1" | grep -E '^\+' | grep -vE '^\+\+\+' | cut -c2-
}

staged="$(git diff --cached --name-only --diff-filter=ACM)"

while IFS= read -r f; do
  [ -z "$f" ] && continue
  base="$(basename "$f")"
  case "$base" in
    *.example) ;;
    .dev.vars|.dev.vars.*|.env|.env.*) problem "$f" "secret file must not be committed" ;;
  esac
done <<< "$staged"

secret_pattern='(ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|ghs_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|sk-[A-Za-z0-9]{32,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
if git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' | grep -qE "$secret_pattern"; then
  problem "diff" "looks like a secret token or private key"
fi

code_files="$(echo "$staged" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)"

while IFS= read -r f; do
  [ -z "$f" ] && continue
  lines="$(added_lines "$f")"
  [ -z "$lines" ] && continue

  if echo "$lines" | grep -E "$comment_start" | grep -qE '(TODO|FIXME|XXX|HACK)'; then
    problem "$f" "TODO/FIXME style comment"
  fi

  if echo "$lines" | grep -E "$comment_start" | grep -qiE '(claude|anthropic|chatgpt|copilot|generated (by|with)|ai[- ]generated)'; then
    problem "$f" "comment mentions an AI tool"
  fi

  if echo "$lines" | grep -qE '^[[:space:]]*//[[:space:]]*[-=*#~_]{4,}'; then
    problem "$f" "banner or divider comment"
  fi

  if echo "$lines" | grep -qE '^[[:space:]]*//[[:space:]]*(const|let|var|import|export|return|if|for|while|await|function|class|console\.)[[:space:](.]'; then
    problem "$f" "commented-out code"
  fi

  total="$(echo "$lines" | grep -cvE '^[[:space:]]*$' || true)"
  comments="$(echo "$lines" | grep -cE '^[[:space:]]*(//|/\*|\*)' || true)"
  if [ "$comments" -ge 6 ] && [ "$total" -gt 0 ] && [ $((comments * 100 / total)) -ge 20 ]; then
    echo "  warning $f: $comments of $total added lines are comments. Keep only comments that explain a non-obvious why." >&2
  fi
done <<< "$code_files"

md_files="$(echo "$staged" | grep -E '\.md$' | grep -vE '(^|/)PROMPTS\.md$|(^|/)PLANNING_PROMPTS\.md$' || true)"

while IFS= read -r f; do
  [ -z "$f" ] && continue
  if added_lines "$f" | grep -q "$em_dash"; then
    problem "$f" "em dash in markdown, use a comma, colon or hyphen"
  fi
done <<< "$md_files"

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: fix the problems above and commit again. Do not bypass this hook." >&2
  exit 1
fi

exit 0
