{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx wrangler dev:*)",
      "Bash(npx wrangler whoami:*)",
      "Bash(npx wrangler types:*)",
      "Bash(npx wrangler --version:*)",
      "Bash(node scripts/:*)",
      "Bash(npx tsx scripts/:*)",
      "Bash(bash scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(curl:*)"
    ],
    "ask": [
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(git push:*)",
      "Bash(gh repo create:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git config core.hooksPath:*)",
      "Read(./.dev.vars)",
      "Read(./.env)"
    ]
  }
}
