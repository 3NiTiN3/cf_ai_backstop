{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-backstop",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "secrets": { "required": ["ADMIN_TOKEN", "QUEUE_ENCRYPTION_KEY"] },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/agents/*",
      "/api/*",
      "/gh",
      "/gh/*",
      "/demo/gh",
      "/demo/gh/*",
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "OpsAgent",
        "name": "OpsAgent",
      },
      {
        "class_name": "RepoGateway",
        "name": "RepoGateway",
      },
      {
        "class_name": "Registry",
        "name": "Registry",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["OpsAgent"],
      "tag": "v1",
    },
    {
      "new_sqlite_classes": ["RepoGateway"],
      "tag": "v2",
    },
    {
      "new_sqlite_classes": ["Registry"],
      "tag": "v3",
    },
  ],
}
