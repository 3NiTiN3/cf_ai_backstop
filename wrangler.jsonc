{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-backstop",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/gh", "/gh/*", "/demo/gh", "/demo/gh/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "OpsAgent",
        "name": "OpsAgent",
      },
      {
        "class_name": "RepoGateway",
        "name": "RepoGateway",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["OpsAgent"],
      "tag": "v1",
    },
    {
      "new_sqlite_classes": ["RepoGateway"],
      "tag": "v2",
    },
  ],
}
