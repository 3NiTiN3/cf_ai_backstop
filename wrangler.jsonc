{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-backstop",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "vars": { "ENVIRONMENT": "production" },
  "secrets": { "required": ["ADMIN_TOKEN", "QUEUE_ENCRYPTION_KEY"] },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/agents/*",
      "/api/*",
      "/mcp",
      "/gh",
      "/gh/*",
      "/demo/gh",
      "/demo/gh/*",
    ],
  },
  "ratelimits": [
    {
      "name": "DEMO_GATEWAY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 10 },
    },
    {
      "name": "DEMO_ACTIONS_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "MCP_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "OpsAgent",
        "name": "OpsAgent",
      },
      {
        "class_name": "RepoGateway",
        "name": "RepoGateway",
      },
      {
        "class_name": "Registry",
        "name": "Registry",
      },
    ],
  },
  "workflows": [
    {
      "name": "backstop-replay",
      "binding": "ReplayWorkflow",
      "class_name": "ReplayWorkflow",
    },
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["OpsAgent"],
      "tag": "v1",
    },
    {
      "new_sqlite_classes": ["RepoGateway"],
      "tag": "v2",
    },
    {
      "new_sqlite_classes": ["Registry"],
      "tag": "v3",
    },
  ],
}
